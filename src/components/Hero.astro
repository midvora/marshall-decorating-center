---
import HeroDecor from './HeroDecor.astro';
import Photo from './Photo.astro';
import Stamp from './Stamp.astro';
import StatusBadge from './StatusBadge.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
---

<section class="hero" aria-labelledby="hero-h" data-hero>
  <HeroDecor />

  <div class="container grid">
    <div class="copy">
      <p class="eyebrow rise" style="--d:0">Marshall, Minnesota · Family owned since {site.founded}</p>

      <h1 id="hero-h" class="display">
        <span class="ln"><span class="w" style="--d:1">Make room</span></span>
        <span class="ln"><span class="w" style="--d:2">for what</span></span>
        <span class="ln">
          <span class="w" style="--d:3"
            ><em class="swash"
              >feels like<svg viewBox="0 0 300 30" preserveAspectRatio="none" aria-hidden="true"
                ><path d="M4 18 C 60 6, 120 26, 180 14 S 270 10, 296 16" pathLength="1"></path></svg
              ></em
            ></span
          >
          <span class="w" style="--d:4">home.</span>
        </span>
      </h1>

      <p class="lede rise" style="--d:5">
        Benjamin Moore paint, flooring, window treatments and décor, all under one roof on West Main Street. Bring a
        photo, a paint chip or just an idea.
      </p>

      <div class="cta-row rise" style="--d:6">
        <a class="btn" href={url('/shop/')}>Shop the store <span class="arr" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href={url('/visit/')}>Plan a visit</a>
      </div>

      <div class="today rise" style="--d:7">
        <StatusBadge />
        <p class="where">
          {site.address}
          <span class="sep" aria-hidden="true">·</span>
          <a href={site.phoneHref}>{site.phoneDisplay}</a>
        </p>
      </div>
    </div>

    <div class="stage rise" style="--d:3">
      <div class="chip">
        <figure class="store" data-hero-photo>
          <Photo
            name="storefront"
            widths={[720, 1080, 1536]}
            sizes="(min-width: 1020px) 58vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
        <div class="foot">
          <p class="find">
            <span class="cap-k">Find us</span>
            <span class="cap-v">Look for the blue awning on W Main St</span>
          </p>
          <span class="bands" aria-hidden="true">
            <i style="background:#7f927e"></i><i style="background:#a8b5a0"></i><i style="background:#ddb968"></i><i
              style="background:#c58468"></i
            ><i style="background:#b47962"></i><i style="background:#9db7c6"></i><i style="background:#46575a"></i>
          </span>
        </div>
      </div>

      <figure class="inside" aria-hidden="false">
        <Photo name="showroomWide" widths={[320, 480]} sizes="220px" pos="30% 50%" />
        <figcaption class="sr-only">Inside the showroom</figcaption>
      </figure>

      <Stamp class="stamp" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(28px, 3.2vw, 48px) clamp(56px, 8vw, 110px);
    overflow: clip;
  }

  .grid {
    display: grid;
    gap: clamp(40px, 6vw, 56px);
    align-items: center;
  }
  @media (min-width: 1020px) {
    .grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(28px, 4vw, 64px);
    }
  }

  .copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }

  h1 {
    font-size: clamp(3.1rem, 0.7rem + 5.7vw, 5.7rem);
    margin-block: 4px 6px;
  }
  .ln {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .w {
    display: inline-block;
    opacity: 0;
    transform: translateY(105%);
    animation: wordup 1.1s var(--ease) forwards;
    animation-delay: calc(var(--d, 0) * 110ms + 120ms);
  }
  .swash {
    position: relative;
    display: inline-block;
    color: var(--clay-deep);
    padding-right: 0.06em;
  }
  .swash svg {
    position: absolute;
    left: -2%;
    bottom: -0.1em;
    width: 104%;
    height: 0.3em;
    z-index: -1;
    overflow: visible;
  }
  .swash path {
    fill: none;
    stroke: var(--wheat);
    stroke-width: 11;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.9;
    animation: draw 1.1s 1.15s var(--ease) forwards;
  }

  .rise {
    opacity: 0;
    transform: translateY(20px);
    animation: rise 0.95s var(--ease) forwards;
    animation-delay: calc(var(--d, 0) * 90ms + 160ms);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  .today {
    display: grid;
    gap: 10px;
    justify-items: start;
    margin-top: 4px;
  }
  .where {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }
  .where a {
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }
  .sep {
    margin-inline: 6px;
    color: var(--clay);
  }

  /* ---- the photo stage ---- */
  .stage {
    --inw: clamp(120px, 15vw, 190px);
    position: relative;
    padding: 0 0 clamp(28px, 4vw, 48px);
  }

  /* The storefront as one big paint-chip card: a wide photo with a single sweeping corner,
     and the color bands along the bottom edge. */
  .chip {
    position: relative;
    padding: clamp(8px, 0.9vw, 12px) clamp(8px, 0.9vw, 12px) 0;
    border-radius: clamp(26px, 3vw, 38px);
    background: var(--paper);
    box-shadow:
      0 70px 100px -48px rgb(34 44 42 / 0.7),
      0 0 0 1px rgb(34 44 42 / 0.08);
  }
  .store {
    position: relative;
    margin: 0;
    aspect-ratio: 3 / 2;
    border-radius: clamp(96px, 17vw, 260px) clamp(14px, 1.6vw, 22px) clamp(14px, 1.6vw, 22px) clamp(14px, 1.6vw, 22px);
    overflow: hidden;
    background: var(--cream);
  }
  .store :global(img) {
    transform-origin: 50% 40%;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    /* the polaroid hangs over the left end of the strip, so the caption starts after it */
    padding: clamp(12px, 1.4vw, 18px) clamp(10px, 1.4vw, 20px) clamp(14px, 1.6vw, 20px) calc(var(--inw) + 16px);
    min-height: clamp(64px, 7vw, 84px);
  }
  .find {
    display: grid;
    gap: 2px;
    line-height: 1.25;
  }
  .bands {
    display: flex;
    flex: none;
    gap: 4px;
  }
  .bands i {
    display: block;
    width: clamp(12px, 1.2vw, 16px);
    height: clamp(30px, 3vw, 40px);
    border-radius: 5px;
  }
  .cap-k {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--clay-deep);
  }
  .cap-v {
    font-family: var(--f-display);
    font-variation-settings: 'opsz' 36;
    font-weight: 520;
    font-size: clamp(0.9375rem, 0.8rem + 0.5vw, 1.0625rem);
  }

  .inside {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 3;
    width: var(--inw);
    aspect-ratio: 4 / 5;
    margin: 0;
    padding: 6px;
    border-radius: 18px;
    background: var(--paper);
    box-shadow: 0 30px 44px -22px rgb(34 44 42 / 0.6);
    transform: rotate(-4deg);
    overflow: hidden;
  }
  .inside :global(img) {
    border-radius: 13px;
  }
  .stage :global(.stamp) {
    position: absolute;
    /* hangs off the top-right corner so it never covers the awning lettering */
    right: clamp(-28px, -1.8vw, -8px);
    top: clamp(-44px, -3vw, -24px);
    z-index: 4;
  }

  @keyframes wordup {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .w,
    .rise {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .swash path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 520px) {
    .stage {
      --inw: 104px;
    }
    .inside {
      left: -4px;
    }
    .bands {
      display: none;
    }
  }
</style>
