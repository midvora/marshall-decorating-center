---
import RoomStudio from './RoomStudio.astro';

const chips = [
  { x: '-1.8%', y: '12%', r: '-14deg', c: ['#a8b5a0', '#8fa086', '#6f8268'], d: 0.5 },
  { x: '47%', y: '-4%', r: '9deg', c: ['#f0d9a0', '#ddb968', '#c49c4a'], d: 0.8 },
  { x: '94%', y: '56%', r: '17deg', c: ['#e3b6a3', '#c58468', '#a8654a'], d: 1.2 },
  { x: '-2%', y: '78%', r: '-6deg', c: ['#b8cdd9', '#9db7c6', '#7c9aab'], d: 0.7 },
];
---

<section class="hero" aria-labelledby="hero-h" data-hero>
  <div class="decor" aria-hidden="true">
    <span class="sun"></span>
    {
      chips.map((c) => (
        <span class="pchip" data-depth={c.d} style={`--x:${c.x};--y:${c.y};--r:${c.r};--c1:${c.c[0]};--c2:${c.c[1]};--c3:${c.c[2]}`}>
          <i></i><i></i><i></i><b></b>
        </span>
      ))
    }
  </div>

  <div class="container grid">
    <div class="copy">
      <p class="eyebrow rise" style="--d:0">Marshall, Minnesota · Paint • Floors • More</p>

      <h1 id="hero-h" class="display">
        <span class="ln"><span class="w" style="--d:1">Make room</span></span>
        <span class="ln"><span class="w" style="--d:2">for what</span></span>
        <span class="ln">
          <span class="w" style="--d:3"
            ><em class="swash"
              >feels like<svg viewBox="0 0 300 30" preserveAspectRatio="none" aria-hidden="true"
                ><path d="M4 18 C 60 6, 120 26, 180 14 S 270 10, 296 16" pathLength="1"></path></svg
              ></em
            ></span
          >
          <span class="w" style="--d:4">home.</span>
        </span>
      </h1>

      <p class="lede rise" style="--d:5">
        Explore paint, flooring, window treatments and décor with a local store that knows the value of a good
        conversation.
      </p>

      <div class="cta-row rise" style="--d:6">
        <a class="btn" href="#explore">Explore the store <span class="arr" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="#visit">Find us on Main Street</a>
      </div>

      <ul class="facts rise" style="--d:7">
        <li>Benjamin Moore paint</li>
        <li>In-store decorating help</li>
        <li>Residential + commercial</li>
      </ul>
    </div>

    <div class="studio-wrap rise" style="--d:3">
      <RoomStudio />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(28px, 3.2vw, 48px) clamp(56px, 8vw, 110px);
    overflow: clip;
  }

  .decor {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .sun {
    position: absolute;
    right: -10%;
    top: -14%;
    width: min(70vw, 820px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, #f3dfae 0%, rgb(243 223 174 / 0.55) 45%, rgb(243 223 174 / 0) 100%);
  }
  .pchip {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: grid;
    grid-template-rows: 1fr 1fr 1fr 26px;
    width: 54px;
    height: 150px;
    border-radius: 5px;
    overflow: hidden;
    transform: rotate(var(--r));
    box-shadow: 0 18px 30px -16px rgb(34 44 42 / 0.45), 0 0 0 1px rgb(34 44 42 / 0.06);
    opacity: 0.9;
  }
  .pchip i:nth-child(1) {
    background: var(--c1);
  }
  .pchip i:nth-child(2) {
    background: var(--c2);
  }
  .pchip i:nth-child(3) {
    background: var(--c3);
  }
  .pchip b {
    position: relative;
    background: #fff;
  }
  .pchip b::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: var(--porcelain);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.35) inset;
  }

  .grid {
    display: grid;
    gap: clamp(36px, 6vw, 56px);
    align-items: center;
  }
  @media (min-width: 1020px) {
    .grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      gap: clamp(32px, 5vw, 80px);
    }
  }

  .copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }

  h1 {
    font-size: clamp(3.1rem, 1rem + 6.2vw, 6.1rem);
    margin-block: 4px 6px;
  }
  .ln {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .w {
    display: inline-block;
    opacity: 0;
    transform: translateY(105%);
    animation: wordup 1.1s var(--ease) forwards;
    animation-delay: calc(var(--d, 0) * 110ms + 120ms);
  }
  .swash {
    position: relative;
    display: inline-block;
    color: var(--clay-deep);
    padding-right: 0.06em;
  }
  .swash svg {
    position: absolute;
    left: -2%;
    bottom: -0.1em;
    width: 104%;
    height: 0.3em;
    z-index: -1;
    overflow: visible;
  }
  .swash path {
    fill: none;
    stroke: var(--wheat);
    stroke-width: 11;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.9;
    animation: draw 1.1s 1.15s var(--ease) forwards;
  }

  .rise {
    opacity: 0;
    transform: translateY(20px);
    animation: rise 0.95s var(--ease) forwards;
    animation-delay: calc(var(--d, 0) * 90ms + 160ms);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }
  .facts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px 7px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--cream) 70%, transparent);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .facts li::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--clay);
  }
  .facts li:nth-child(2)::before {
    background: var(--sage);
  }
  .facts li:nth-child(3)::before {
    background: var(--wheat);
  }

  .studio-wrap {
    padding-top: 34px;
  }

  @keyframes wordup {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .w,
    .rise {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .swash path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 1019px) {
    .pchip {
      display: none;
    }
  }
</style>
