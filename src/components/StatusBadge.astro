---
/**
 * "Open now / Closed" pill. Server-rendered as a neutral "See hours" so it is correct without JavaScript;
 * scripts/status.ts fills in the live state from the store's hours, in the store's own time zone.
 */
interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}
const { tone = 'light', class: cls } = Astro.props;
---

<p class:list={['status', `status--${tone}`, cls]} data-status data-state="unknown">
  <span class="dot" aria-hidden="true"></span>
  <span class="txt" data-status-text>See today's hours below</span>
</p>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 14px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.2;
    background: color-mix(in srgb, var(--cream) 80%, transparent);
    color: var(--ink);
  }
  .status--dark {
    background: rgb(247 244 238 / 0.14);
    color: var(--porcelain);
  }
  .dot {
    position: relative;
    width: 10px;
    height: 10px;
    flex: none;
    border-radius: 50%;
    background: #9aa39d;
  }
  [data-state='open'] .dot {
    background: #4f8a5b;
  }
  [data-state='open'] .dot::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 2px solid #4f8a5b;
    opacity: 0;
    animation: ping 2.2s ease-out infinite;
  }
  [data-state='closed'] .dot {
    background: var(--clay);
  }
  @keyframes ping {
    0% {
      transform: scale(0.5);
      opacity: 0.7;
    }
    100% {
      transform: scale(1.3);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-state='open'] .dot::after {
      animation: none;
    }
  }
</style>
