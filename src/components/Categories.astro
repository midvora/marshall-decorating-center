---
import Photo from './Photo.astro';
import { url } from '../lib/url';

const cards = [
  {
    no: '01',
    title: 'Paint & color',
    copy: 'Benjamin Moore, mixed right here in a very wide range of colors.',
    photo: 'paintWall',
    pos: '50% 30%',
    href: '/paint/',
    more: 'Explore paint & color',
  },
  {
    no: '02',
    title: 'Wallpaper',
    copy: 'Pattern and texture for the wall that deserves a little drama.',
    photo: 'wallpaperBlue',
    pos: '50% 38%',
    href: '/paint/#wallpaper',
    more: 'See wallpaper',
  },
  {
    no: '03',
    title: 'Flooring',
    copy: 'Vinyl plank and tile, hardwood and more, by the stack.',
    photo: 'floorHardwood',
    pos: '50% 62%',
    href: '/flooring/',
    more: 'Explore flooring',
  },
  {
    no: '04',
    title: 'Window treatments',
    copy: 'Bring light, privacy and texture into balance.',
    photo: 'windowSheersDrapes',
    pos: '45% 50%',
    href: '/window-treatments/',
    more: 'Explore window treatments',
  },
  {
    no: '05',
    title: 'Décor & furnishings',
    copy: 'Chairs, chests, art and lamps. Pull it together, one thoughtful choice at a time.',
    photo: 'seatingHeron',
    pos: '50% 45%',
    href: '/home-decor/',
    more: 'Explore décor',
  },
  {
    no: '06',
    title: 'Gifts & accessories',
    copy: 'Something small and thoughtful for a host, a home or yourself.',
    photo: 'wallpaperBar',
    pos: '78% 55%',
    href: '/home-decor/#gifts',
    more: 'See gifts',
  },
] as const;
---

<section class="explore" id="explore" aria-labelledby="explore-h" tabindex="-1">
  <div class="container">
    <header class="head">
      <p class="eyebrow" data-reveal>Explore the store</p>
      <h2 id="explore-h" class="display" data-split>Start with a color. <em>Finish with a room.</em></h2>
      <p class="lede" data-reveal>
        Six departments, one friendly store. These are real corners of the showroom on West Main Street. Tap any one to
        see what is on the floor.
      </p>
    </header>

    <div class="grid" data-stagger>
      {
        cards.map((c) => (
          <article class="card" data-card>
            <div class="art">
              <Photo name={c.photo} pos={c.pos} widths={[480, 720, 960]} sizes="(min-width: 1020px) 30vw, (min-width: 640px) 46vw, 100vw" />
            </div>

            <div class="label">
              <p class="no">No. {c.no}</p>
              <h3 class="name">{c.title}</h3>
              <p class="copy">{c.copy}</p>
              <a class="more" href={url(c.href)}>
                {c.more}
                <span class="arr" aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <p class="shop-hint" data-reveal>
      Want to build a list before you come in?
      <a href={url('/shop/')}>Shop the store <span aria-hidden="true">→</span></a>
    </p>
  </div>
</section>

<style>
  .explore {
    position: relative;
    padding-block: clamp(72px, 10vw, 150px) clamp(72px, 9vw, 130px);
    outline: none;
  }

  .head {
    display: grid;
    gap: 22px;
    margin-bottom: clamp(40px, 6vw, 84px);
  }
  .head h2 {
    font-size: clamp(2.6rem, 1rem + 6.2vw, 6.4rem);
    max-width: 11em;
  }
  .head h2 em {
    color: var(--clay-deep);
  }
  @media (min-width: 900px) {
    .head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
      align-items: end;
      column-gap: 48px;
    }
    .head .eyebrow {
      grid-column: 1 / -1;
    }
  }

  .grid {
    display: grid;
    gap: clamp(18px, 2.4vw, 32px);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1020px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding-bottom: 56px;
    }
    .card:nth-child(3n + 2) {
      transform: translateY(56px);
    }
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 10px;
    background: #fff;
    overflow: hidden;
    box-shadow:
      0 30px 50px -30px rgb(34 44 42 / 0.5),
      0 0 0 1px rgb(34 44 42 / 0.08);
    transition: box-shadow 0.6s var(--ease), translate 0.6s var(--ease);
  }
  .card:hover,
  .card:focus-within {
    translate: 0 -8px;
    box-shadow:
      0 44px 64px -30px rgb(34 44 42 / 0.6),
      0 0 0 1px rgb(34 44 42 / 0.1);
  }
  .card:focus-within {
    outline: 3px solid var(--clay-deep);
    outline-offset: 4px;
  }

  .art {
    position: relative;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--cream);
  }
  .art :global(img) {
    transition: transform 1.3s var(--ease);
  }
  .card:hover .art :global(img),
  .card:focus-within .art :global(img) {
    transform: scale(1.06);
  }

  .label {
    position: relative;
    padding: 22px 24px 28px;
  }
  .label::before {
    content: '';
    position: absolute;
    right: 20px;
    top: 20px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--porcelain);
    box-shadow: 0 2px 3px rgb(0 0 0 / 0.28) inset;
  }
  .no {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .name {
    margin-top: 6px;
    font-family: var(--f-display);
    font-variation-settings: 'opsz' 72;
    font-weight: 480;
    font-size: clamp(1.6rem, 1.3rem + 0.9vw, 2.05rem);
    letter-spacing: -0.02em;
    line-height: 1.08;
  }
  .copy {
    margin-top: 10px;
    color: var(--ink-soft);
    font-size: 1rem;
    max-width: 24em;
    text-wrap: pretty;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--clay-deep);
    text-decoration: none;
  }
  .more::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .more .arr {
    transition: transform 0.4s var(--ease);
  }
  .card:hover .more .arr {
    transform: translateX(6px);
  }
  .more:focus-visible {
    outline: none;
  }

  .shop-hint {
    margin-top: clamp(40px, 6vw, 72px);
    text-align: center;
    color: var(--ink-soft);
  }
  .shop-hint a {
    margin-left: 6px;
    font-weight: 600;
    color: var(--clay-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .art :global(img),
    .card {
      transition: none;
    }
  }
</style>
