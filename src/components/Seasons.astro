---
import Photo from './Photo.astro';
import { url } from '../lib/url';

const seasons = [
  {
    key: 'spring',
    label: 'Spring',
    title: 'Florals & Easter décor',
    copy: 'Blossoms, bunnies and fresh table settings for the first warm days.',
    photo: 'springTable',
    pos: '50% 30%',
    href: '/promotions/spring-florals/',
  },
  {
    key: 'summer',
    label: 'Summer',
    title: 'Crazy Days sales',
    copy: 'Great deals and a cool, air-conditioned place to shop.',
    photo: 'navyStripe',
    pos: '50% 45%',
    href: '/promotions/summer-crazy-days/',
  },
  {
    key: 'fall',
    label: 'Fall',
    title: 'Fall florals & harvest décor',
    copy: 'Pumpkins, warm leaves and cozy color for the months ahead.',
    photo: 'fallWide',
    pos: '36% 50%',
    href: '/promotions/fall-harvest/',
  },
  {
    key: 'holiday',
    label: 'Holiday',
    title: 'The holiday table',
    copy: 'Reindeer, gnomes and snowflakes, set against the color wall.',
    photo: 'paintWall',
    pos: '50% 78%',
    href: '/promotions/holiday-table/',
  },
] as const;
---

<section class="seasons" id="seasons" aria-labelledby="seasons-h">
  <div class="container">
    <header class="head">
      <p class="eyebrow" data-reveal>Through the year</p>
      <h2 id="seasons-h" class="display" data-split>The shelves change <em>with the seasons.</em></h2>
      <p class="lede" data-reveal>
        There is always a reason to stop in and see what is new. Displays and sales change from season to season, so
        ask what is on the floor.
      </p>
    </header>

    <ol class="arches" data-arches>
      {
        seasons.map((s) => (
          <li class={`arch arch--${s.key}`} data-arch>
            <div class="shape">
              <Photo name={s.photo} pos={s.pos} widths={[360, 540, 720]} sizes="(min-width: 1020px) 22vw, (min-width: 640px) 40vw, 80vw" />
            </div>
            <div class="cap">
              <p class="lab">{s.label}</p>
              <h3 class="ttl">
                <a class="stretch" href={url(s.href)}>{s.title}</a>
              </h3>
              <p class="txt">{s.copy}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .seasons {
    position: relative;
    background: var(--cream);
    padding-block: clamp(72px, 10vw, 150px);
    overflow: clip;
  }
  .head {
    display: grid;
    gap: 22px;
    margin-bottom: clamp(48px, 7vw, 96px);
  }
  .head h2 {
    font-size: clamp(2.5rem, 1rem + 5.6vw, 5.6rem);
    max-width: 11em;
  }
  .head h2 em {
    color: var(--sage-deep);
  }
  @media (min-width: 900px) {
    .head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 360px);
      align-items: end;
      column-gap: 48px;
    }
    .head .eyebrow {
      grid-column: 1 / -1;
    }
  }

  .arches {
    display: grid;
    gap: clamp(36px, 4vw, 56px) clamp(18px, 2.4vw, 36px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .arches {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
    .arch:nth-child(even) {
      margin-top: 48px;
    }
  }
  @media (min-width: 1020px) {
    .arches {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .arch:nth-child(even) {
      margin-top: 56px;
    }
    .arch:nth-child(3) {
      margin-top: 20px;
    }
  }
  @media (max-width: 639px) {
    .arch {
      max-width: 420px;
      margin-inline: auto;
      width: 100%;
    }
  }

  .arch {
    position: relative;
    display: grid;
    gap: 22px;
  }
  .shape {
    position: relative;
    aspect-ratio: 300 / 380;
    border-radius: 999px 999px 18px 18px;
    overflow: hidden;
    background: var(--sky);
    box-shadow: 0 40px 60px -36px rgb(34 44 42 / 0.55);
    transition: transform 0.8s var(--ease);
  }
  .arch:hover .shape,
  .arch:focus-within .shape {
    transform: translateY(-8px);
  }
  .shape :global(img) {
    transition: transform 1.4s var(--ease);
  }
  .arch:hover .shape :global(img) {
    transform: scale(1.06);
  }
  .cap {
    display: grid;
    gap: 6px;
    padding-inline: 6px;
  }
  .lab {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--clay-deep);
  }
  .ttl {
    font-family: var(--f-display);
    font-variation-settings: 'opsz' 72;
    font-weight: 460;
    font-size: clamp(1.45rem, 1.2rem + 0.8vw, 1.85rem);
    letter-spacing: -0.02em;
    line-height: 1.08;
  }
  .stretch {
    text-decoration: none;
  }
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .arch:focus-within {
    outline: 3px solid var(--clay-deep);
    outline-offset: 6px;
    border-radius: 18px;
  }
  .stretch:focus-visible {
    outline: none;
  }
  .txt {
    color: var(--ink-soft);
    max-width: 24em;
  }

  @media (prefers-reduced-motion: reduce) {
    .shape,
    .shape :global(img) {
      transition: none;
    }
  }
</style>
