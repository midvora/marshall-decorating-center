---
import SectionHead from './SectionHead.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede?: string;
  steps: { title: string; copy: string }[];
  tone?: 'light' | 'cream';
}
const { id, eyebrow, title, lede, steps, tone = 'cream' } = Astro.props;
---

<section class:list={['band', { 'band--cream': tone === 'cream' }]} aria-labelledby={`${id}-h`}>
  <div class="container">
    <SectionHead id={`${id}-h`} eyebrow={eyebrow} title={title} lede={lede} split={!!lede} />

    <ol class="steps">
      {
        steps.map((s, i) => (
          <li data-rise>
            <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.copy}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      gap: clamp(20px, 3vw, 44px);
    }
  }
  li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 8px;
    padding-top: 22px;
    border-top: 2px solid var(--ink);
  }
  .n {
    font-family: var(--f-display);
    font-variation-settings: 'opsz' 144;
    font-weight: 380;
    font-style: italic;
    font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem);
    line-height: 1;
    color: var(--clay-deep);
  }
  h3 {
    font-family: var(--f-display);
    font-variation-settings: 'opsz' 72;
    font-weight: 480;
    font-size: clamp(1.35rem, 1.15rem + 0.6vw, 1.6rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  p {
    color: var(--ink-soft);
    text-wrap: pretty;
  }
</style>
