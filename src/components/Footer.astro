---
import { site, hours, nav } from '../data/site';
import { url } from '../lib/url';

const links = [...nav, { href: '/visit/', label: 'Visit' }];
---

<footer class="foot on-dark">
  <div class="ribbon" aria-hidden="true">
    <i style="background:#7f927e"></i><i style="background:#a8b5a0"></i><i style="background:#ddb968"></i><i
      style="background:#c58468"></i
    ><i style="background:#b47962"></i><i style="background:#9db7c6"></i><i style="background:#46575a"></i>
  </div>
  <div class="container inner">
    <div class="who">
      <p class="name">{site.name}</p>
      <p class="addr">
        {site.address}<br />
        <a href={site.phoneHref}>{site.phoneDisplay}</a><br />
        <a href={site.facebookHref} target="_blank" rel="noopener noreferrer"
          >Follow along on Facebook<span class="sr-only"> (opens in a new tab)</span></a
        >
      </p>
    </div>

    <nav class="links" aria-label="Footer">
      {links.map((l) => <a href={url(l.href)}>{l.label}</a>)}
      <a href="#top">Back to top ↑</a>
    </nav>

    <div class="hrs">
      <p class="k">Hours</p>
      <dl>
        {
          hours.map((h) => (
            <div>
              <dt>{h.label}</dt>
              <dd>{h.open ? `${h.open} – ${h.close}` : 'Closed'}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="legal">
      <p>
        <strong>Unofficial concept by Midvora.</strong> This is a design sample, not {site.name}'s current website.
        Details should be confirmed with the business.
      </p>
      <p class="credit">Concept created by Midvora</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--ink);
    color: var(--porcelain);
    padding-bottom: calc(40px + env(safe-area-inset-bottom));
  }
  .inner {
    display: grid;
    gap: 36px 48px;
    padding-top: clamp(40px, 6vw, 72px);
  }
  @media (min-width: 900px) {
    .inner {
      grid-template-columns: 1.15fr 0.7fr 0.95fr;
      align-items: start;
    }
    .legal {
      grid-column: 1 / -1;
      grid-template-columns: 1fr auto;
      align-items: end;
      padding-top: 28px;
      border-top: 1px solid rgb(247 244 238 / 0.14);
      max-width: none;
    }
  }
  .name {
    font-family: var(--f-display);
    font-variation-settings: 'opsz' 72;
    font-size: clamp(1.8rem, 1.3rem + 1.6vw, 2.5rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .addr {
    margin-top: 12px;
    color: #cdd5d0;
    line-height: 1.8;
  }
  .addr a,
  .links a {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1.5px no-repeat;
    transition: background-size 0.45s var(--ease);
  }
  .addr a:hover,
  .links a:hover {
    background-size: 100% 1.5px;
  }
  .links {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 8px 36px;
    justify-content: start;
    font-weight: 500;
  }
  .k {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9fa9a4;
  }
  .hrs dl {
    display: grid;
    gap: 6px;
    margin: 10px 0 0;
    color: #cdd5d0;
    font-size: 0.9375rem;
  }
  .hrs dl div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    max-width: 280px;
  }
  .hrs dt,
  .hrs dd {
    margin: 0;
  }
  .legal {
    display: grid;
    gap: 12px;
    color: #cdd5d0;
    font-size: 0.9375rem;
    max-width: 38em;
  }
  .legal strong {
    color: var(--wheat);
    font-weight: 600;
  }
  .credit {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9fa9a4;
  }
</style>
