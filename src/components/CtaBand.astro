---
import StatusBadge from './StatusBadge.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

/** The closing strip on inner pages. Carries data-visit so the mobile action bar knows when to step aside. */
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Questions? Come <em>talk it through.</em>',
  text = 'Bring a photo, a paint chip or just an idea. We are on West Main Street, with parking in front and back.',
} = Astro.props;
---

<section class="cta on-dark" aria-labelledby="cta-h" data-visit>
  <div class="container inner">
    <div class="msg">
      <StatusBadge tone="dark" />
      <h2 id="cta-h" class="display" set:html={title} />
      <p class="lede">{text}</p>
    </div>
    <div class="acts">
      <a class="btn btn--light" href={site.phoneHref}>Call {site.phoneDisplay}</a>
      <a class="btn btn--ghost-light" href={site.directionsHref} target="_blank" rel="noopener noreferrer"
        >Get directions <span class="sr-only">(opens in a new tab)</span><span class="arr" aria-hidden="true">↗</span></a
      >
      <a class="btn btn--ghost-light" href={url('/visit/')}>Hours &amp; map</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--clay-deep);
    color: var(--porcelain);
    padding-block: clamp(56px, 7vw, 96px);
  }
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 80% at 92% 0%, rgb(221 185 104 / 0.3), transparent 70%),
      radial-gradient(50% 60% at 0% 100%, rgb(0 0 0 / 0.25), transparent 70%);
  }
  .inner {
    display: grid;
    gap: 32px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .inner {
      grid-template-columns: minmax(0, 1.2fr) auto;
      gap: 56px;
    }
  }
  .msg {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  h2 {
    font-size: clamp(2.2rem, 1rem + 4vw, 4.2rem);
    max-width: 12em;
  }
  h2 :global(em) {
    color: var(--wheat);
  }
  .lede {
    color: #f7ece4;
    max-width: 32em;
  }
  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (min-width: 900px) {
    .acts {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
