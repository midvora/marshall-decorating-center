---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { departments, shopItems } from '../data/shop';
import { url } from '../lib/url';

const deptLabel = Object.fromEntries(departments.map((d) => [d.id, d.label]));
const how = [
  { n: '1', t: 'Browse', c: 'Real displays from the showroom floor.' },
  { n: '2', t: 'Add to my list', c: 'Tap anything you want to see, price or hold.' },
  { n: '3', t: 'Send to the store', c: 'We follow up with a quote or set it aside for you.' },
];
---

<Base
  title="Shop the store | Marshall Decorating Center (unofficial concept by Midvora)"
  description="Browse what is on the floor at Marshall Decorating Center, build a list, and send it to the store for a quote or to hold for pickup."
>
  <Header />
  <main id="main" tabindex="-1">
    <PageHero
      crumb="Shop"
      eyebrow="Shop the store"
      title="Browse, build a list, <em>and we'll take it from there.</em>"
      lede="A look at what is on the floor right now. Add anything to your list and send it to the store for a quote, or ask us to hold it for pickup."
      photo="showroomWide"
      pos="40% 50%"
      shape="card"
    >
      <button class="btn" type="button" data-list-open>
        View my list <span class="arr" aria-hidden="true">→</span>
      </button>
      <a class="btn btn--ghost" href={url('/visit/')}>Visit the store</a>
    </PageHero>

    <section class="how band band--cream" aria-label="How shopping here works">
      <ol class="container steps">
        {
          how.map((h) => (
            <li data-rise>
              <span class="n" aria-hidden="true">{h.n}</span>
              <span class="t"><strong>{h.t}</strong><span>{h.c}</span></span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="band shop" aria-labelledby="shop-h">
      <div class="container">
        <h2 id="shop-h" class="sr-only">All displays</h2>

        <div class="toolbar" data-reveal>
          <div class="chips" role="group" aria-label="Filter by department">
            {
              departments.map((d) => (
                <button type="button" class="chip" data-filter={d.id} aria-pressed={d.id === 'all' ? 'true' : 'false'}>
                  {d.label}
                </button>
              ))
            }
          </div>
          <p class="count" data-shop-status aria-live="polite">Showing {shopItems.length} displays</p>
        </div>

        <ul class="grid">
          {
            shopItems.map((it) => (
              <li class="card" data-item data-dept={it.dept} data-rise>
                <div class="art">
                  <Photo name={it.photo} pos={it.pos} widths={[360, 540, 720]} sizes="(min-width: 1020px) 30vw, (min-width: 640px) 46vw, 92vw" />
                  <span class="badge">{it.tag}</span>
                </div>
                <div class="body">
                  <p class="dept">{deptLabel[it.dept]}</p>
                  <h3><a href={url(it.href)}>{it.name}</a></h3>
                  <p class="line">{it.line}</p>
                  <button
                    type="button"
                    class="add"
                    data-add
                    data-id={it.id}
                    data-name={it.name}
                    data-dept={deptLabel[it.dept]}
                    aria-pressed="false"
                  >
                    <span class="plus" aria-hidden="true"></span>
                    <span class="lbl">Add to my list</span>
                  </button>
                </div>
              </li>
            ))
          }
        </ul>

        <p class="fine">
          Displays change often and there are no prices online: the store sets those. Call {`(507) 532-4666`} to check
          what is in stock.
        </p>
      </div>
    </section>

    <CtaBand title="Rather <em>talk it through?</em>" text="Call or stop by. A decorator is happy to help you build the list." />
  </main>
  <Footer />
  <MobileBar />
</Base>

<style>
  .how {
    padding-block: clamp(28px, 4vw, 44px);
  }
  .steps {
    display: grid;
    gap: 14px;
    margin-block: 0;
    padding-block: 0;
    list-style: none;
  }
  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 36px;
    }
  }
  .steps li {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .n {
    display: grid;
    place-items: center;
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--porcelain);
    font-family: var(--f-display);
    font-size: 1.35rem;
  }
  .t {
    display: grid;
    line-height: 1.3;
  }
  .t strong {
    font-family: var(--f-display);
    font-variation-settings: 'opsz' 72;
    font-weight: 500;
    font-size: 1.25rem;
  }
  .t span:not(:first-child) {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .toolbar {
    display: grid;
    gap: 14px;
    margin-bottom: clamp(24px, 4vw, 40px);
  }
  @media (min-width: 900px) {
    .toolbar {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    min-height: 44px;
    padding: 0 18px;
    border: 1.5px solid color-mix(in srgb, var(--ink) 30%, transparent);
    border-radius: 999px;
    background: transparent;
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: background 0.3s var(--ease), color 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .chip:hover {
    border-color: var(--ink);
  }
  .chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--porcelain);
  }
  .count {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .grid {
    display: grid;
    gap: clamp(16px, 2.2vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1020px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 12px;
    background: #fff;
    box-shadow:
      0 28px 44px -32px rgb(34 44 42 / 0.55),
      0 0 0 1px rgb(34 44 42 / 0.08);
    transition: box-shadow 0.5s var(--ease), translate 0.5s var(--ease);
  }
  .card[hidden] {
    display: none;
  }
  .card:hover,
  .card:focus-within {
    translate: 0 -6px;
    box-shadow:
      0 40px 56px -32px rgb(34 44 42 / 0.6),
      0 0 0 1px rgb(34 44 42 / 0.1);
  }
  .art {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--cream);
  }
  .art :global(img) {
    transition: transform 1.2s var(--ease);
  }
  .card:hover .art :global(img) {
    transform: scale(1.05);
  }
  .badge {
    position: absolute;
    left: 12px;
    top: 12px;
    z-index: 2;
    padding: 5px 11px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clay-deep);
  }
  .body {
    display: grid;
    flex: 1;
    align-content: start;
    gap: 6px;
    padding: 20px 22px 22px;
  }
  .dept {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  h3 {
    font-family: var(--f-display);
    font-variation-settings: 'opsz' 72;
    font-weight: 480;
    font-size: 1.45rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  h3 a {
    text-decoration: none;
  }
  .line {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    text-wrap: pretty;
  }
  .add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    justify-self: start;
    min-height: 44px;
    margin-top: 12px;
    padding: 0 18px 0 14px;
    border: 1.5px solid var(--clay-deep);
    border-radius: 999px;
    background: transparent;
    color: var(--clay-deep);
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: background 0.3s var(--ease), color 0.3s var(--ease);
  }
  .add:hover {
    background: var(--clay-deep);
    color: #fff;
  }
  .plus {
    position: relative;
    width: 14px;
    height: 14px;
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 2px;
    margin: -1px 0 0 -7px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.3s var(--ease);
  }
  .plus::after {
    transform: rotate(90deg);
  }
  .add.is-added {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--porcelain);
  }
  .add.is-added .plus::before {
    width: 8px;
    margin: 0 0 0 -7px;
    top: 58%;
    transform: rotate(45deg);
  }
  .add.is-added .plus::after {
    width: 14px;
    margin: -1px 0 0 -3px;
    transform: rotate(-50deg);
  }

  .fine {
    margin-top: clamp(28px, 4vw, 44px);
    text-align: center;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .art :global(img) {
      transition: none;
    }
  }
</style>
