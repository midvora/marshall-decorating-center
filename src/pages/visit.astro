---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Visit from '../components/Visit.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import SectionHead from '../components/SectionHead.astro';
import Photo from '../components/Photo.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../data/site';

const faqs = [
  { q: 'What are your hours?', a: 'Monday through Friday 8:00 AM to 5:30 PM, Saturday 9:00 AM to 1:00 PM, and closed on Sunday. Holiday hours may vary, so give us a call if you are planning a special trip.' },
  { q: 'Do you only carry Benjamin Moore paint?', a: 'Yes. Paint at Marshall Decorating Center is Benjamin Moore only, and we mix it in the store in a very wide range of colors.' },
  { q: 'Where can I park?', a: 'There is parking in the front and back lots, right off West Main Street.' },
  { q: 'Can I bring a photo or a paint chip?', a: 'Please do. A photo of the room, a chip, a fabric or just an idea is the best way to start the conversation with one of our decorators.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
  title="Visit | Marshall Decorating Center (unofficial concept by Midvora)"
  description="Find Marshall Decorating Center at 440 W Main St in Marshall, Minnesota. Hours, phone, directions and parking."
  schema
>
  <Header />
  <main id="main" tabindex="-1">
    <Visit level="h1" />

    <FeatureGrid
      id="bring"
      eyebrow="Before you come"
      title="Bring a little <em>and we'll do the rest.</em>"
      cols={3}
      tone="cream"
      items={[
        { k: 'For paint', title: 'A photo, a chip or a fabric', copy: 'Anything that shows the color or the mood you are after.' },
        { k: 'For floors & windows', title: 'Rough measurements', copy: 'Length and width of the room, or the size of each window.' },
        { k: 'For anything', title: 'An idea', copy: 'You do not need a plan. We will start from where you are.' },
      ]}
    />

    <section class="band contact" aria-labelledby="contact-h">
      <div class="container cg">
        <div class="cintro">
          <SectionHead id="contact-h" eyebrow="Send a message" title="Prefer to <em>write first?</em>" lede="Tell us what you are working on and we will get back to you. For anything urgent, please call." />
          <p class="line"><a href={site.phoneHref}>{site.phoneDisplay}</a></p>
        </div>

        <div class="fwrap">
          <form class="form" data-sample-form>
            <label class="field"><span>Your name</span><input name="name" required autocomplete="name" /></label>
            <label class="field"><span>Phone or email</span><input name="contact" required autocomplete="email" /></label>
            <label class="field">
              <span>What is it about?</span>
              <select name="topic">
                <option>Paint &amp; color</option>
                <option>Wallpaper</option>
                <option>Flooring</option>
                <option>Window treatments</option>
                <option>Décor &amp; furniture</option>
                <option>Something else</option>
              </select>
            </label>
            <label class="field"><span>Message</span><textarea name="message" rows="4"></textarea></label>
            <button class="btn" type="submit">Send message <span class="arr" aria-hidden="true">→</span></button>
            <p class="fine">Sample only: nothing is sent anywhere. On the finished site this goes to the store.</p>
          </form>
          <div class="sent" data-sample-done hidden tabindex="-1">
            <p class="eyebrow">Sample message</p>
            <h3 class="display">Thank you.</h3>
            <p>
              On the finished site, this message would reach the store's inbox and they would reply by phone or email.
              This is a sample, so nothing was sent.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="band band--cream" aria-labelledby="faq-h">
      <div class="container">
        <SectionHead id="faq-h" eyebrow="Good to know" title="Quick <em>answers.</em>" />
        <div class="faq">
          {
            faqs.map((f) => (
              <details data-rise>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    </section>

    <section class="front" aria-label="The storefront">
      <figure>
        <Photo name="storefront" widths={[720, 1200]} sizes="100vw" pos="40% 50%" />
        <figcaption>
          <span>Look for the blue awning</span>
          {site.address}
        </figcaption>
      </figure>
    </section>
  </main>
  <Footer />
  <MobileBar />
</Base>

<style>
  .cg {
    display: grid;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  @media (min-width: 900px) {
    .cg {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }
  .cintro :global(.head) {
    margin-bottom: 18px;
  }
  .line a {
    font-family: var(--f-display);
    font-variation-settings: 'opsz' 72;
    font-size: clamp(1.8rem, 1.3rem + 1.6vw, 2.6rem);
    letter-spacing: -0.02em;
    color: var(--clay-deep);
  }

  .form {
    display: grid;
    gap: 16px;
    padding: clamp(22px, 3vw, 36px);
    border-radius: 22px;
    background: #fff;
    box-shadow:
      0 40px 70px -44px rgb(34 44 42 / 0.55),
      0 0 0 1px rgb(34 44 42 / 0.08);
  }
  .form[hidden],
  .sent[hidden] {
    display: none;
  }
  .field {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 1.5px solid color-mix(in srgb, var(--ink) 28%, transparent);
    border-radius: 12px;
    background: var(--paper);
    font: inherit;
    font-weight: 400;
    color: var(--ink);
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: 3px solid var(--clay-deep);
    outline-offset: 2px;
  }
  .form .btn {
    justify-self: start;
  }
  .fine {
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
  .sent {
    display: grid;
    gap: 14px;
    padding: clamp(26px, 4vw, 44px);
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(34 44 42 / 0.08);
    outline: none;
  }
  .sent h3 {
    font-size: 2.6rem;
  }

  .faq {
    display: grid;
    gap: 10px;
    max-width: 820px;
  }
  details {
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(34 44 42 / 0.08);
  }
  summary {
    position: relative;
    padding: 20px 56px 20px 22px;
    list-style: none;
    cursor: pointer;
    font-family: var(--f-display);
    font-variation-settings: 'opsz' 72;
    font-weight: 480;
    font-size: 1.3rem;
    letter-spacing: -0.01em;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    position: absolute;
    right: 22px;
    top: 50%;
    translate: 0 -50%;
    font-family: var(--f-body);
    font-size: 1.6rem;
    color: var(--clay-deep);
    transition: rotate 0.3s var(--ease);
  }
  details[open] summary::after {
    rotate: 45deg;
  }
  details p {
    padding: 0 22px 22px;
    color: var(--ink-soft);
    max-width: 44em;
  }

  .front figure {
    position: relative;
    margin: 0;
    height: clamp(260px, 38vw, 520px);
    overflow: hidden;
  }
  .front figcaption {
    position: absolute;
    left: var(--gutter);
    bottom: var(--gutter);
    z-index: 2;
    display: grid;
    gap: 2px;
    padding: 14px 20px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    box-shadow: 0 20px 36px -16px rgb(0 0 0 / 0.5);
    line-height: 1.3;
  }
  .front figcaption span {
    font-family: var(--f-display);
    font-variation-settings: 'opsz' 72;
    font-weight: 520;
    font-size: 1.3rem;
  }
</style>
